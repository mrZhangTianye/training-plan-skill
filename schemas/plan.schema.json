{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "0.1",
        "0.2",
        "0.3"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "cycle",
        "block",
        "week",
        "session"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "executable"
      ]
    },
    "intended_use": {
      "type": "string",
      "enum": [
        "demo",
        "actual"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "duration_weeks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "objectives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/objective"
      },
      "minItems": 1
    },
    "arrangement": {
      "$ref": "#/$defs/arrangement"
    },
    "blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      },
      "minItems": 1
    },
    "weeks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/week"
      },
      "minItems": 1
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "design_review": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      },
      "minItems": 0
    },
    "design_context": {
      "type": "object",
      "properties": {
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability_id": {
                "type": "string",
                "enum": [
                  "strength",
                  "power",
                  "speed",
                  "endurance",
                  "mobility",
                  "balance",
                  "coordination",
                  "elasticity",
                  "rotation",
                  "landing_control",
                  "fundamental_movement"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "develop",
                  "maintain",
                  "defer",
                  "unassessed"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "capability_id",
              "mode",
              "rationale"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "uncertainty_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "recovery_review": {
          "type": "string",
          "minLength": 1
        },
        "environment_context": {
          "type": "string",
          "minLength": 1
        },
        "contact_budget": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "reentry": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "new",
                "continuing",
                "paused",
                "exit",
                "returning"
              ]
            },
            "missed_days": {
              "type": "integer",
              "minimum": 0
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "current_basis": {
              "type": "string",
              "minLength": 1
            },
            "first_session_strategy": {
              "type": "string",
              "minLength": 1
            },
            "association_review": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "state",
            "missed_days",
            "reason",
            "current_basis",
            "first_session_strategy",
            "association_review"
          ],
          "additionalProperties": false
        },
        "review_resolutions": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "properties": {
              "review_id": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "string",
                "enum": [
                  "accepted_tradeoff",
                  "modified_plan"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "context_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "review_id",
              "decision",
              "rationale"
            ],
            "additionalProperties": false
          }
        },
        "aerobic_plan": {
          "type": "object",
          "properties": {
            "target_weekly_equivalent_minutes": {
              "type": "number",
              "minimum": 0
            },
            "target_by_week": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "minimum": 0
              }
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "target_weekly_equivalent_minutes",
            "rationale"
          ],
          "additionalProperties": false
        },
        "strength_waves": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "unit_ids": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "first_week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "last_week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "first_week",
              "last_week",
              "rationale"
            ],
            "anyOf": [
              {
                "required": [
                  "unit_id"
                ]
              },
              {
                "required": [
                  "unit_ids"
                ]
              }
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 0,
          "description": "结构性限制。每条给一条可查规则，脚本按 impact／category 扫全计划的动作；只写不查的散文限制不算。",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "region": {
                "type": "string",
                "minLength": 1,
                "description": "部位，如 膝／肩／腰／踝"
              },
              "rule": {
                "type": "string",
                "enum": [
                  "no_impact",
                  "no_load",
                  "no_overhead"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "长期",
                  "阶段性"
                ],
                "description": "长期＝结构性、无症状、永久（只改动作选择，不占恢复预算）；阶段性＝可逆、正在占恢复预算（如伤后恢复期）。未标注按阶段性处理（保守）"
              },
              "scope": {
                "type": "string",
                "minLength": 1,
                "description": "具体到做什么不行、什么还可以"
              },
              "clear_when": {
                "type": "string",
                "description": "什么条件下解除。必须挂在可观察记录上并写明次数与基线，如 影像确认骨愈合／按原剂量连续完成 3 次且次晨无晨痛；不写「症状消失即可解除」这类主观条件。解除只针对本条，不连带其他条"
              },
              "until_week": {
                "type": "integer",
                "minimum": 1,
                "description": "在第几周后重新评估"
              }
            },
            "required": [
              "rule",
              "scope"
            ]
          }
        }
      },
      "required": [
        "coverage",
        "uncertainty_actions",
        "recovery_review",
        "environment_context",
        "contact_budget",
        "reentry"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "window": {
          "enum": [
            "day",
            "week"
          ]
        },
        "dates": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "date"
          },
          "minItems": 1,
          "maxItems": 7
        }
      },
      "required": [
        "window",
        "dates"
      ],
      "additionalProperties": false
    },
    "ball_days": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "sport": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "start_time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "duration_minutes": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1440
          }
        },
        "required": [
          "id",
          "date",
          "sport",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "level",
    "title",
    "status",
    "intended_use",
    "start_date",
    "duration_weeks",
    "profile",
    "objectives",
    "arrangement",
    "blocks",
    "weeks",
    "sessions",
    "evidence",
    "design_review"
  ],
  "additionalProperties": false,
  "$defs": {
    "objective": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "develop",
            "maintain",
            "defer",
            "unassessed"
          ]
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "desired_change": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "strength",
              "power",
              "speed",
              "endurance",
              "mobility",
              "balance",
              "coordination",
              "elasticity",
              "rotation",
              "landing_control",
              "fundamental_movement"
            ]
          },
          "minItems": 0
        },
        "baseline_basis": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "prior_test",
                "training_record",
                "self_report",
                "unknown"
              ]
            },
            "date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "observation": {
              "type": "string",
              "minLength": 1
            },
            "limitations": {
              "type": "string",
              "minLength": 1
            },
            "adequacy": {
              "type": "string",
              "enum": [
                "sufficient",
                "limited",
                "unknown"
              ]
            },
            "run_sessions_per_week": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "run_longest_minutes": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "run_weekly_minutes": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "minutes_basis": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "date",
            "observation",
            "limitations",
            "adequacy"
          ],
          "additionalProperties": false
        },
        "progression_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "first_week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "last_week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "session_frequency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 14
              },
              "planned_dose": {
                "type": "string",
                "minLength": 1
              },
              "progression": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "first_week",
              "last_week",
              "session_frequency",
              "planned_dose",
              "progression"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "capability",
        "mode",
        "baseline",
        "desired_change",
        "rationale"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "baseline_date": {
          "type": "string",
          "format": "date"
        },
        "available_minutes": {
          "type": "object",
          "properties": {
            "0": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "1": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "2": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "3": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "4": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "5": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "6": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "equipment": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "mastery": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "unknown",
              "learning",
              "independent"
            ]
          }
        },
        "banned_units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "restrictions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "weekday": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "start": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              },
              "end": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            },
            "required": [
              "weekday",
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "pool": {
          "type": "object",
          "properties": {
            "length_m": {
              "type": "number",
              "minimum": 0.01
            },
            "pace_seconds_per_100m": {
              "type": "number",
              "minimum": 0.01
            }
          },
          "required": [
            "length_m"
          ],
          "additionalProperties": false
        },
        "swim_task_readiness": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unknown",
                  "learning",
                  "ready"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "continuous_distance_m": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "status",
              "basis"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "baseline_date",
        "available_minutes",
        "equipment",
        "mastery",
        "banned_units",
        "restrictions"
      ],
      "additionalProperties": false
    },
    "load": {
      "type": "object",
      "properties": {
        "page_load": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_rpe": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "reference_weight_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reference_weight_unit": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "per_hand",
            "total",
            "added",
            null
          ]
        },
        "reference_weight_basis": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "execution_target": {
          "type": "string",
          "minLength": 1
        },
        "selection_method": {
          "type": [
            "string",
            "null"
          ],
          "description": "选重方法：怎么写清组次与目标RPE下如何取重量；公斤数未知时以本字段替代参考重量"
        }
      },
      "required": [
        "target_rpe",
        "reference_weight_kg",
        "description"
      ],
      "additionalProperties": false
    },
    "dose": {
      "type": "object",
      "properties": {
        "sets": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "duration_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "distance_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "per_side": {
          "type": "boolean"
        },
        "load": {
          "$ref": "#/$defs/load"
        },
        "rest_seconds": {
          "type": "number",
          "minimum": 0
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "tempo": {
          "type": "object",
          "properties": {
            "eccentric_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "pause_seconds": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "required": [
            "eccentric_seconds",
            "pause_seconds"
          ],
          "additionalProperties": false
        },
        "recovery_type": {
          "type": "string",
          "enum": [
            "rest",
            "active_recovery",
            "sendoff"
          ]
        },
        "sendoff_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1
        },
        "distance_estimate_m": {
          "type": "number",
          "minimum": 0.01
        },
        "distance_estimate_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sets",
        "reps",
        "duration_minutes",
        "distance_m",
        "per_side",
        "load",
        "rest_seconds",
        "notes"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "unit_id": {
          "type": "string",
          "minLength": 1
        },
        "dose": {
          "$ref": "#/$defs/dose"
        },
        "cue": {
          "type": "string",
          "minLength": 1
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        },
        "duration_minutes": {
          "type": "number",
          "minimum": 0
        },
        "dose_basis": {
          "type": "string",
          "minLength": 1
        },
        "capability_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "strength",
              "power",
              "speed",
              "endurance",
              "mobility",
              "balance",
              "coordination",
              "elasticity",
              "rotation",
              "landing_control",
              "fundamental_movement"
            ]
          },
          "minItems": 0
        },
        "contacts_per_rep": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "work_seconds_per_set": {
          "type": "number",
          "minimum": 0.01
        },
        "execution_note": {
          "type": "string",
          "minLength": 1
        },
        "aerobic_minutes": {
          "type": "number",
          "minimum": 0
        },
        "aerobic_intensity": {
          "type": "string",
          "enum": [
            "light",
            "moderate",
            "vigorous"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "wave_role": {
          "type": "string",
          "enum": [
            "capacity",
            "moderate",
            "heavy"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "endurance_role": {
          "type": "string",
          "enum": [
            "run",
            "swim",
            "walk"
          ]
        },
        "run_intensity": {
          "type": "string",
          "enum": [
            "easy",
            "tempo",
            "interval",
            "fast"
          ]
        },
        "partial_length": {
          "type": "boolean"
        },
        "tempo_seconds_per_rep": {
          "type": "number",
