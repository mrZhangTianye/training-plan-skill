      "minimum": 1
    },
    "after_version": {
      "type": "integer",
      "minimum": 1
    },
    "before_hash": {
      "type": "string",
      "minLength": 1
    },
    "after_hash": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
